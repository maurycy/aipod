#!/bin/sh

# aipod - container management script
# style inspired by https://get.chezmoi.io

set -e

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/aipod"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/aipod"
MOUNTS_FILE="${CONFIG_DIR}/mounts"
PORTS_FILE="${CONFIG_DIR}/ports"

# Defaults (set after config is loaded)
HOSTNAME=""
IMAGE_NAME=""
CONTAINER_NAME=""
USERNAME=""
CHEZMOI_DOTFILES_REPO=""
USE_RUST="true"
USE_NPM="true"
USE_UV="true"
USE_CLAUDE_CODE="true"
USE_CODEX="true"
USE_COPILOT="true"
USE_PI="true"
USE_AGY="true"
USE_MISE="false"
USE_OVERMIND="false"
USE_JUST="false"
CONTAINERFILE=""
CAP_ADD=""
CREATE_ARGS=""

usage() {
	cat <<EOF
aipod: manage development containers

Usage: aipod [command] [options]

Commands:
    up          Start container interactively (default if no command given)
    down        Stop the container
    status      Show container status
    clean       Remove container, image, mount and ports config

    run         Run command in container
    cp          Copy file/directory to/from container

    map         Add volume mount (alias: mount)
    unmap       Remove volume mount (alias: unmount, umount, umap)
    port        Expose container port
    close       Remove port mapping

    config      Edit aipod.conf
    help        Show this help

Mapping directories:
    aipod map                       Map current directory to container
    aipod map <path>                Map path to container
    aipod map <path> <remote>       Map path to specified container path
    aipod unmap                     Remove all mappings
    aipod unmap <path>              Remove mapping for specified path

Port usage:
    aipod port <port>               Expose container port to same host port
    aipod port <port> <host>        Expose container port to specified host port
    aipod close <port>              Remove port mapping for container port
    aipod close                     Remove all port mappings

Run usage:
    aipod run <command> [args...]   Run command in container at translated CWD

Copying:
    aipod cp <file|directory>       Copy file/directory to container
    aipod cp :<path> [local-path]   Copy from container (default: current dir)
EOF
	exit 0
}

log() {
	printf '%s %s\n' "$1" "$2" >&2
}

die() {
	log "$1" "$2"
	exit 1
}

is_command() { type "$1" >/dev/null 2>&1; }

# Find config directory containing aipod.conf
# Checks script directory first (for development), then XDG config directory
find_config_dir() {
	script_dir="$(cd "$(dirname "$0")" && pwd)"
	if [ -f "${script_dir}/aipod.conf" ]; then
		printf '%s' "${script_dir}"
		return 0
	fi
	if [ -f "${CONFIG_DIR}/aipod.conf" ]; then
		printf '%s' "${CONFIG_DIR}"
		return 0
	fi
	# No config found, return config directory as default
	printf '%s' "${CONFIG_DIR}"
}

load_config() {
	config_dir="$(find_config_dir)"
	if [ -f "${config_dir}/aipod.conf" ]; then
		# shellcheck disable=SC1091
		. "${config_dir}/aipod.conf"
	fi
	# Apply defaults - HOSTNAME from config becomes CONTAINER_NAME and IMAGE_NAME
	CONTAINER_NAME="${HOSTNAME:-aipod}"
	IMAGE_NAME="${HOSTNAME:-aipod}"
	USERNAME="${USERNAME:-developer}"

	# Resolve CONTAINERFILE: config value, or search DATA_DIR
	if [ -n "${CONTAINERFILE}" ]; then
		case "${CONTAINERFILE}" in
			/*)
				;;
			*)
                if [ -f "${DATA_DIR}/${CONTAINERFILE}" ]; then
					CONTAINERFILE="${DATA_DIR}/${CONTAINERFILE}"
				fi
				;;
			esac
	else
		script_dir="$(cd "$(dirname "$0")" && pwd)"
		if [ -f "${script_dir}/Containerfile" ]; then
			CONTAINERFILE="${script_dir}/Containerfile"
		elif [ -f "${DATA_DIR}/Containerfile" ]; then
			CONTAINERFILE="${DATA_DIR}/Containerfile"
		fi
	fi

	if [ ! -f "${CONTAINERFILE}" ]; then
		die critical "Containerfile not found: ${CONTAINERFILE:-<not set>}"
	fi
}

ensure_config_dir() { [ -d "${CONFIG_DIR}" ] || mkdir -p "${CONFIG_DIR}"; }

config_entry_exists() {
	[ -f "$1" ] || return 1
	awk -F: -v field="$2" -v value="$3" \
		'$field==value {found=1} END{exit !found}' "$1"
}

container_exists() { podman container exists "${CONTAINER_NAME}" 2>/dev/null; }
container_running() { [ "$(podman container inspect -f '{{.State.Running}}' "${CONTAINER_NAME}" 2>/dev/null)" = "true" ]; }
image_exists() { podman image exists "${IMAGE_NAME}" 2>/dev/null; }
snapshot_exists() { podman image exists "${IMAGE_NAME}:snapshot" 2>/dev/null; }

run_image() {
	if snapshot_exists; then
		printf '%s' "${IMAGE_NAME}:snapshot"
	else
		printf '%s' "${IMAGE_NAME}"
	fi
}

podman_exec() {
	if [ -t 0 ] && [ -t 1 ] && [ -t 2 ]; then
		podman exec -it "$@"
	else
		podman exec -i "$@"
	fi
}

podman_exec_at_cwd() {
	container_cwd="$(host_to_container_path "$(pwd -P)" || true)"
	if [ -n "${container_cwd}" ]; then
		podman_exec -w "${container_cwd}" "$@"
	else
		podman_exec "$@"
	fi
}

# Translate host path to container path using mounts file
# Returns 0 and prints container path if found, returns 1 if not covered by any mount
# Resolves symlinks on both input path and mount paths for correct matching
host_to_container_path() {
	host_path="$1"
	[ -f "${MOUNTS_FILE}" ] || return 1

	# Resolve symlinks in input path (must be a directory for CWD use case)
	resolved_host="$(cd -P "${host_path}" 2>/dev/null && pwd -P)" || return 1

	while IFS=: read -r local_dir remote_dir; do
		[ -z "${local_dir}" ] && continue

		# Resolve symlinks in mount path
		resolved_local="$(cd -P "${local_dir}" 2>/dev/null && pwd -P)" || continue

		case "${resolved_host}" in
			"${resolved_local}")
				printf '%s\n' "${remote_dir}"
				return 0
				;;
			"${resolved_local}"/*)
				relative="${resolved_host#"${resolved_local}"}"
				printf '%s%s\n' "${remote_dir}" "${relative}"
				return 0
				;;
		esac
	done < "${MOUNTS_FILE}"
	return 1
}

# Start container without opening interactive shell
cmd_up_headless() {
	cmd_build
	set --
	if [ -f "${MOUNTS_FILE}" ]; then
		while IFS= read -r line; do
			[ -z "${line}" ] && continue
			set -- "$@" -v "$line"
		done < "${MOUNTS_FILE}"
	fi
	if [ -f "${PORTS_FILE}" ]; then
		while IFS= read -r line; do
			[ -z "${line}" ] && continue
			set -- "$@" -p "$line"
		done < "${PORTS_FILE}"
	fi
	for cap in ${CAP_ADD}; do
		set -- "$@" --cap-add "$cap"
	done
	# shellcheck disable=SC2086
	set -- "$@" ${CREATE_ARGS}
	if container_exists; then
		if ! container_running; then
			log info "starting container ${CONTAINER_NAME}"
			if ! podman start "${CONTAINER_NAME}" >/dev/null; then
				log error "failed to start container ${CONTAINER_NAME}"
				return 1
			fi
		fi
	else
		log info "creating container ${CONTAINER_NAME}"
		podman run -d \
			--replace \
			--init \
			--hostname "${CONTAINER_NAME}" \
			--name "${CONTAINER_NAME}" \
			"$@" \
			"$(run_image)" \
			tail -f /dev/null
	fi
	if ! container_running; then
		log error "container ${CONTAINER_NAME} is not running - recreate with 'aipod clean'"
		return 1
	fi
}

commit_snapshot() {
	if container_exists; then
		log info "committing container state"
		podman commit --quiet "${CONTAINER_NAME}" "${IMAGE_NAME}:snapshot" >/dev/null
		podman rm -f "${CONTAINER_NAME}" >/dev/null 2>&1 || true
	fi
}

recreate_container() {
	container_exists || return 0
	commit_snapshot
	log info "$1"
	cmd_up_headless
}

cmd_build() {
	if ! image_exists; then
		log info "building image ${IMAGE_NAME}"
		podman build \
			--build-arg USERNAME="${USERNAME}" \
			--build-arg CHEZMOI_DOTFILES_REPO="${CHEZMOI_DOTFILES_REPO}" \
			--build-arg USE_RUST="${USE_RUST}" \
			--build-arg USE_NPM="${USE_NPM}" \
			--build-arg USE_UV="${USE_UV}" \
			--build-arg USE_CLAUDE_CODE="${USE_CLAUDE_CODE}" \
			--build-arg USE_CODEX="${USE_CODEX}" \
			--build-arg USE_COPILOT="${USE_COPILOT}" \
			--build-arg USE_PI="${USE_PI}" \
			--build-arg USE_AGY="${USE_AGY}" \
			--build-arg USE_MISE="${USE_MISE}" \
			--build-arg USE_OVERMIND="${USE_OVERMIND}" \
			--build-arg USE_JUST="${USE_JUST}" \
			-t "${IMAGE_NAME}" \
			-f "${CONTAINERFILE}" \
			"$(dirname "${CONTAINERFILE}")"
	fi
}

cmd_up() {
	cmd_up_headless
	log info "opening shell in running container ${CONTAINER_NAME}"
	podman_exec_at_cwd "${CONTAINER_NAME}" /bin/zsh
}

cmd_down() {
	if container_exists; then
		log info "stopping container ${CONTAINER_NAME}"
		podman stop "${CONTAINER_NAME}" 2>/dev/null || true
	else
		log info "container ${CONTAINER_NAME} does not exist"
	fi
}

cmd_clean() {
	log info "stopping container ${CONTAINER_NAME}"
	podman stop "${CONTAINER_NAME}" 2>/dev/null || true
	log info "removing container ${CONTAINER_NAME}"
	podman rm "${CONTAINER_NAME}" 2>/dev/null || true
	log info "removing snapshot image"
	podman rmi "${IMAGE_NAME}:snapshot" 2>/dev/null || true
	log info "removing image ${IMAGE_NAME}"
	podman rmi "${IMAGE_NAME}" 2>/dev/null || true
	log info "removing mounts config"
	rm -f "${MOUNTS_FILE}"
	log info "removing ports config"
	rm -f "${PORTS_FILE}"
}

cmd_run() {
	if [ $# -eq 0 ]; then
		die error "usage: aipod run <command> [args...]"
	fi

	cmd_up_headless
	podman_exec_at_cwd "${CONTAINER_NAME}" zsh -ic "$*"
}

cmd_cp() {
	if [ -z "${1:-}" ]; then
		die error "usage: aipod cp <file|directory> | aipod cp :<container-path> [local-path]"
	fi

	if [ "${1#:}" != "$1" ]; then
		container_path="${1#:}"
		local_path="${2:-.}"
		cmd_up_headless
		log info "syncing ${CONTAINER_NAME}:${container_path} -> ${local_path}"
		podman cp "${CONTAINER_NAME}:${container_path}" "${local_path}"
		return
	fi

	if [ -d "$1" ]; then
		src="$(cd "$1" && pwd)"
	elif [ -f "$1" ]; then
		src="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
	else
		die error "path does not exist: $1"
	fi

	# Get container destination - use mount path if available, else default to home
	container_path="$(host_to_container_path "${src}")" || {
		container_path="/home/${USERNAME}/$(basename "${src}")"
	}

	cmd_up_headless
	log info "syncing ${src} -> ${container_path}"
	podman cp "${src}" "${CONTAINER_NAME}:${container_path}"
}

cmd_map() {
	local_path="${1:-$(pwd)}"
	local_path="$(cd "${local_path}" 2>/dev/null && pwd || printf '%s' "${local_path}")"
	basename="$(basename "${local_path}")"
	remote_path="${2:-/home/${USERNAME}/${basename}}"

	case "${remote_path}" in
		/*) ;;
		*) remote_path="/home/${USERNAME}/${remote_path}" ;;
	esac

	if [ "${local_path}" = "${HOME}" ]; then
		die error "mounting your home directory is a bad idea, and goes against the purpose of containerization"
	fi

	ensure_config_dir

	if config_entry_exists "${MOUNTS_FILE}" 1 "${local_path}"; then
		log info "mount for ${local_path} already exists"
		return 0
	fi

	if config_entry_exists "${MOUNTS_FILE}" 2 "${remote_path}"; then
		die error "destination ${remote_path} is already mounted from another path"
	fi

	log info "mounting ${local_path} to ${remote_path}"
	printf '%s:%s\n' "${local_path}" "${remote_path}" >> "${MOUNTS_FILE}"
	recreate_container "recreating container with new mount"
}

remove_config_entry() {
	config_type="$1"
	config_file="$2"
	config_field="$3"
	config_value="$4"

	case "${config_type}" in
	mount)
		empty_message="no mounts configured"
		all_message="removing all mounts"
		item_message="removing mount for ${config_value}"
		error_message="failed to update mounts file"
		recreate_message="recreating container without mount"
		;;
	port)
		empty_message="no ports exposed"
		all_message="removing all port mappings"
		item_message="closing port ${config_value}"
		error_message="failed to update ports file"
		recreate_message="recreating container without port"
		;;
	esac

	if [ ! -f "${config_file}" ]; then
		log info "${empty_message}"
		return 0
	fi
	if [ -z "${config_value}" ]; then
		log info "${all_message}"
		rm -f "${config_file}"
	else
		log info "${item_message}"
		tmp_file="${config_file}.tmp"
		if awk -F: -v field="${config_field}" -v value="${config_value}" \
			'$field!=value' "${config_file}" > "${tmp_file}"; then
			mv "${tmp_file}" "${config_file}"
		else
			rm -f "${tmp_file}"
			die error "${error_message}"
		fi
		[ -s "${config_file}" ] || rm -f "${config_file}"
	fi
	recreate_container "${recreate_message}"
}

cmd_unmap() {
	local_path="${1:-}"
	if [ -n "${local_path}" ]; then
		local_path="$(cd "${local_path}" 2>/dev/null && pwd || printf '%s' "${local_path}")"
	fi
	remove_config_entry mount "${MOUNTS_FILE}" 1 "${local_path}"
}

valid_port() {
	case "$1" in
		''|*[!0-9]*) return 1 ;;
	esac
	[ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

cmd_port() {
	container_port="${1:-}"
	if [ -z "${container_port}" ]; then
		die error "usage: aipod expose <port> [host_port]"
	fi
	host_port="${2:-${container_port}}"

	if ! valid_port "${container_port}"; then
		die error "invalid container port: ${container_port} (must be 1-65535)"
	fi
	if ! valid_port "${host_port}"; then
		die error "invalid host port: ${host_port} (must be 1-65535)"
	fi

	ensure_config_dir

	if config_entry_exists "${PORTS_FILE}" 2 "${container_port}"; then
		log info "port ${container_port} already exposed"
		return 0
	fi

	log info "exposing port ${container_port} to host port ${host_port}"
	printf '%s:%s\n' "${host_port}" "${container_port}" >> "${PORTS_FILE}"
	recreate_container "recreating container with new port"
}

cmd_close() { remove_config_entry port "${PORTS_FILE}" 2 "${1:-}"; }

cmd_config() {
	editor="${EDITOR:-vi}"
	config_dir="$(find_config_dir)"
	"${editor}" "${config_dir}/aipod.conf"
}

show_config_entries() {
	printf '%s:\n' "$1"
	if [ -f "$2" ]; then
		while IFS= read -r line; do
			[ -z "${line}" ] && continue
			printf '  %s\n' "${line}"
		done < "$2"
	else
		printf '  (none)\n'
	fi
}

cmd_status() {
	if container_exists; then
		if container_running; then
			printf 'container: running\n'
		else
			printf 'container: stopped\n'
		fi
	else
		printf 'container: not created\n'
	fi

	if image_exists; then
		printf 'image:     %s\n' "${IMAGE_NAME}"
	else
		printf 'image:     not built\n'
	fi

	if snapshot_exists; then
		printf 'snapshot:  %s:snapshot\n' "${IMAGE_NAME}"
	else
		printf 'snapshot:  (none)\n'
	fi

	show_config_entries mounts "${MOUNTS_FILE}"
	show_config_entries ports "${PORTS_FILE}"
}

main() {
	if ! is_command podman; then
		die critical "podman is not installed - see https://podman.io/docs/installation"
	fi

	load_config

	cmd="${1:-}"
	if [ "$#" -gt 0 ]; then
		shift
	fi

	case "${cmd}" in
	"" | start) cmd="up" ;;
	stop) cmd="down" ;;
	cleanup | purge) cmd="clean" ;;
	sync) cmd="cp" ;;
	st | info | ps) cmd="status" ;;
	mount) cmd="map" ;;
	unmount | umount | umap) cmd="unmap" ;;
	expose | bind | listen) cmd="port" ;;
	unbind) cmd="close" ;;
	help | usage | -h | --help)
		usage
		;;
	up | down | clean | run | cp | status | map | unmap | port | close | config)
		;;
	*)
		log error "unknown command: ${cmd}"
		usage
		;;
	esac
	"cmd_${cmd}" "$@"
}

main "$@"
